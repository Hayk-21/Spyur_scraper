DB_URL=postgresql://user:password@host/dbname?sslmode=require
SCRAPER_CHECKPOINT_ID=4
# request pacing (listing/detail pages)
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=3.0
TREE_DELAY=0.7
MAX_RETRIES=3
MAX_CONSECUTIVE_CHALLENGES=8
# per-run budgets - a 'capped' run is retried after RETRY_CAPPED_HOURS
MAX_LISTING_PAGES_PER_RUN=6000
MAX_DETAIL_PER_RUN=1500
# weekly service schedule (no cron - python scraper.py --service)
SCRAPE_INTERVAL_DAYS=7
RETRY_CAPPED_HOURS=24
RETRY_FAILED_HOURS=6
SERVICE_POLL_SECONDS=3600
